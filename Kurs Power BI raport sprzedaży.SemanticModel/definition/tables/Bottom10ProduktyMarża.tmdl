	partition Bottom10ProduktyMarża = calculated
		mode: import
		source = ```
				
				VAR ProduktyZSumaSprzedazy =
				    FILTER (
				        ADDCOLUMNS (
				            product,
				            "Marża 2023", [Marża % 2023],
				            "Sprzedaż 2023", [Sprzedaż 2023]
				        ),
				        [Sprzedaż 2023] > 0
				    )
				RETURN
				    TOPN (
				        10,
				        ProduktyZSumaSprzedazy,
				        [Marża % 2023],
				        ASC
				    )
				
				```

	annotation PBI_Id = 1f4703c922254801891cb759163117e8

